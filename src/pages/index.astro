---
import Base from '../layouts/Base.astro';
import Galaxy from '../components/Galaxy.astro';
import ModeDemo from '../components/ModeDemo.astro';
import Star from '../components/Star.astro';
import Waitlist from '../components/Waitlist.astro';
import { faq, integrationsAvailable, integrationsPlanned, segments, site, team, url } from '../data/site';

const problems = [
  {
    title: 'Cinq applis pour un seul moment',
    text: 'Launcher, logiciel du casque, appli des lumières, musique, messagerie : chacun se règle à part, avant chaque session.',
  },
  {
    title: 'Une marque, un logiciel',
    text: 'Les outils des fabricants ne pilotent que leur propre matériel. Ton setup, lui, mélange plusieurs marques.',
  },
  {
    title: 'Les scripts, c’est pour les techniciens',
    text: 'Automatiser avec AutoHotkey ou des raccourcis demande du code. La plupart des gens abandonnent.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Compose ton mode',
    text: 'Choisis des actions dans une liste : ouvrir une appli, régler le son, changer la lumière, lancer un jeu. Aucune ligne de code.',
  },
  {
    n: '02',
    title: 'Déclenche-le',
    text: 'Un clic ou un raccourci aujourd’hui. Bientôt à la voix, à une heure donnée, au lancement d’un jeu ou au début d’une réunion.',
  },
  {
    n: '03',
    title: 'Nexum vérifie',
    text: 'Chaque action renvoie un résultat. Si une lumière ne répond pas, tu le vois, et tu peux relancer ou ignorer l’étape.',
  },
];

const compare = [
  { name: 'Logiciels constructeurs', sub: 'Razer Synapse, Corsair iCUE…', brands: 'Une seule marque', code: 'Sans code', scope: 'Périphériques' },
  { name: 'Scripts', sub: 'AutoHotkey, raccourcis', brands: 'Toutes', code: 'Code requis', scope: 'Ce que tu codes' },
  { name: 'Launchers', sub: 'Steam, Playnite…', brands: '—', code: 'Sans code', scope: 'Jeux seulement' },
  { name: 'Nexum', sub: 'Modes', brands: 'Toutes', code: 'Sans code', scope: 'Applis, système, jeux, lumières' },
];

const roadmap = [
  { when: 'Aujourd’hui', what: 'Prototype sur ordinateur : modes, son, luminosité, applis, Steam / Epic / GOG, Philips Hue.' },
  { when: 'Automne 2026', what: 'Entretiens avec des joueurs, streamers et télétravailleurs pour choisir les prochains modes.' },
  { when: 'Hiver 2026', what: 'Déclencheurs automatiques, commande vocale, premières intégrations Spotify, Discord et OBS.' },
  { when: '2027', what: 'Bêta fermée pour les inscrits, puis ouverture progressive.' },
];

const modeLines = [
  { mode: 'Gaming', what: 'Volume · Lumières · Steam' },
  { mode: 'Travail', what: 'Notifs coupées · Slack' },
  { mode: 'Chill', what: 'Musique · Lumière tamisée' },
];
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{site.stage}</p>
        <h1>Un clic.<br />Tout ton setup.</h1>
        <Star />
        <p class="lead">
          <strong>Nexum règle ton PC selon ce que tu fais.</strong> Tu choisis un mode, et le son, la luminosité, les lumières et tes applis suivent. Sans script, quelle que soit la marque de ton matériel.
        </p>
        <ul class="mode-lines">
          {modeLines.map((l) => (
            <li><strong>{l.mode} :</strong><span class="dash" aria-hidden="true"></span><span>{l.what}</span></li>
          ))}
        </ul>
        <div class="ctas">
          <a class="btn btn-primary" href="#beta">Rejoindre la bêta</a>
          <a class="btn btn-ghost" href="#modes">Voir un mode en action</a>
        </div>
      </div>
      <Galaxy />
    </div>
  </section>

  <section class="section" id="probleme">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Le problème</p>
        <h2>Avant chaque session, tu règles tout à la main.</h2>
      </div>
      <div class="grid-3">
        {problems.map((p) => (
          <article class="card">
            <h3>{p.title}</h3>
            <p class="muted">{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="fonctionnement">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Fonctionnement</p>
        <h2>Un mode, c’est une liste d’actions. Nexum s’occupe du reste.</h2>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <span class="n">{s.n}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="modes">
    <div class="wrap split">
      <div class="section-head sticky">
        <p class="eyebrow">Essaie</p>
        <h2>Active un mode pour voir.</h2>
        <p class="lead">Choisis un mode puis clique sur « Activer ». Coche la panne pour voir comment Nexum te prévient quand une action échoue.</p>
      </div>
      <ModeDemo />
    </div>
  </section>

  <section class="section" id="integrations">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Intégrations</p>
        <h2>Une action, plusieurs marques.</h2>
        <p class="lead">Nexum pense en besoins (« lancer la musique », « changer la lumière ») puis utilise le service que tu as. Voici où on en est, sans exagérer.</p>
      </div>
      <div class="integ">
        <div>
          <h3 class="integ-title"><span class="tag">✓ Disponible</span> dans le prototype</h3>
          <ul class="chips">{integrationsAvailable.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div>
          <h3 class="integ-title"><span class="tag">○ Prévu</span> sur la feuille de route</h3>
          <ul class="chips planned">{integrationsPlanned.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="comparaison">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Pourquoi Nexum</p>
        <h2>Ce que les autres outils ne relient pas.</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th scope="col">Outil</th><th scope="col">Marques</th><th scope="col">Code</th><th scope="col">Ce qu’il pilote</th></tr>
          </thead>
          <tbody>
            {compare.map((c) => (
              <tr class={c.name === 'Nexum' ? 'us' : ''}>
                <th scope="row">{c.name}<small>{c.sub}</small></th>
                <td>{c.brands}</td>
                <td>{c.code}</td>
                <td>{c.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="pour-qui">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Pour qui</p>
        <h2>Un setup, trois façons de s’en servir.</h2>
      </div>
      <div class="grid-3">
        {segments.map((s) => (
          <a class="card seg" href={url(`pour/${s.slug}`)}>
            <p class="eyebrow">{s.label}</p>
            <h3>{s.title}</h3>
            <span class="more">Découvrir →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="feuille-de-route">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Feuille de route</p>
        <h2>Où en est Nexum.</h2>
        <p class="lead">Nexum est un projet étudiant EIP à Epitech, construit par {team.length} personnes : {team.join(', ')}. On avance en public.</p>
      </div>
      <ol class="roadmap">
        {roadmap.map((r, i) => (
          <li class={i === 0 ? 'now' : ''}>
            <p class="when">{r.when}</p>
            <p>{r.what}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap faq">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Questions fréquentes.</h2>
      </div>
      <div class="qa">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p class="muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Waitlist />
</Base>

<style>
  .hero {
    padding-block: clamp(48px, 8vw, 96px) clamp(72px, 10vw, 120px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }

  .hero-text {
    display: grid;
    gap: 26px;
  }

  .mode-lines {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }

  .mode-lines li {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--text-2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .mode-lines strong {
    min-width: 96px;
    color: var(--text);
    font-family: var(--font-title);
    font-stretch: var(--title-stretch);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .dash {
    flex: 0 1 80px;
    height: 1px;
    background: var(--line-strong);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 6px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .steps li {
    display: grid;
    gap: 12px;
    align-content: start;
    padding-top: 22px;
    border-top: 1px solid var(--line-strong);
  }

  .n {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text-3);
  }

  .split {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .sticky {
    position: sticky;
    top: 110px;
    margin-bottom: 0;
  }

  .integ {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .integ-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-size: 16px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 9px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    font-size: 14px;
  }

  .chips.planned li {
    border-style: dashed;
    color: var(--text-2);
  }

  :global(:root:not([data-theme='light'])) .chips.planned li {
    border-color: rgb(255 255 255 / 0.2);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
  }

  table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: 15px;
  }

  th,
  td {
    padding: 16px 20px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  thead th {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  tbody th {
    font-weight: 500;
  }

  tbody th small {
    display: block;
    font-weight: 400;
    color: var(--text-3);
    font-size: 13px;
  }

  td {
    color: var(--text-2);
  }

  tr:last-child th,
  tr:last-child td {
    border-bottom: 0;
  }

  tr.us {
    background: var(--btn-bg);
  }

  tr.us th,
  tr.us td,
  tr.us small {
    color: var(--btn-text);
  }

  .seg {
    display: grid;
    gap: 14px;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  .seg:hover {
    border-color: var(--text-2);
    transform: translateY(-2px);
  }

  .more {
    font-size: 14px;
    color: var(--text-2);
  }

  .roadmap {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roadmap li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 20px;
    border-top: 1px dashed var(--line-strong);
    color: var(--text-2);
  }

  .roadmap li.now {
    border-top: 2px solid var(--text);
  }

  .when {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
  }

  .faq {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 5vw, 72px);
  }

  .qa details {
    border-bottom: 1px solid var(--line-strong);
  }

  .qa details:first-child {
    border-top: 1px solid var(--line-strong);
  }

  .qa summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font-size: 17px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .qa summary::-webkit-details-marker {
    display: none;
  }

  .qa summary::after {
    content: '+';
    font-family: var(--mono);
    color: var(--text-3);
  }

  .qa details[open] summary::after {
    content: '−';
  }

  .qa details p {
    padding-bottom: 22px;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .split,
    .faq,
    .integ {
      grid-template-columns: 1fr;
    }

    .sticky {
      position: static;
    }

    .steps,
    .roadmap {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .steps,
    .roadmap {
      grid-template-columns: 1fr;
    }

    .mode-lines strong {
      min-width: 80px;
    }

    .dash {
      display: none;
    }
  }
</style>
