---
// Une page par cible (joueurs, streamers, télétravail). Chaque page envoie son segment
// avec le formulaire : on mesure quelle cible s'inscrit le plus.
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ModeStage from '../../components/ModeStage.astro';
import Waitlist from '../../components/Waitlist.astro';
import { demoModes, segments, site, type Segment } from '../../data/site';

export function getStaticPaths() {
  return segments.map((segment) => ({ params: { segment: segment.slug }, props: { segment } }));
}

interface Props {
  segment: Segment;
}

const { segment } = Astro.props;
// Une seule teinte par page : celle du profil de la cible.
const tint = (demoModes.find((m) => m.id === segment.mode) ?? demoModes[0]!).tint;
---

<Base title={`Nexum pour les ${segment.label.toLowerCase()}`} description={segment.lead} tint={tint}>
  <Hero eyebrow={`Nexum / ${segment.label}`} tint={tint}>
    <Fragment slot="title">{segment.title}</Fragment>
    <p class="lead">{segment.lead}</p>
    <div class="ctas">
      <a class="btn btn-primary" href="#beta">Rejoindre la bêta</a>
      <a class="btn" href="#demo">Essayer le mode</a>
    </div>
    <p class="meta">{site.stage}</p>
  </Hero>

  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <p class="lab">01 / Pourquoi Nexum</p>
        <h2>Ce que ça change pour vous.</h2>
      </div>
      <div class="cards">
        {segment.pains.map((p, i) => (
          <article class="panel card">
            <span class="big">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="demo">
    <div class="wrap">
      <div class="sec-head">
        <p class="lab">02 / Essai</p>
        <h2>Votre mode, étape par étape.</h2>
        <p>Maintenez « Activer ». Chaque action affiche son résultat, même quand quelque chose échoue.</p>
      </div>
      <ModeStage initial={segment.mode} />
    </div>
  </section>

  <Waitlist segment={segment.slug} title="Rejoignez la bêta." />
</Base>

<style>
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 16px;
    padding-top: 6px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 700 11px/1.4 var(--font-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .meta::before {
    content: '';
    width: 7px;
    height: 7px;
    background: rgb(var(--tint));
    box-shadow: 0 0 9px rgb(var(--tint));
    animation: blink 1.4s steps(2) infinite;
  }

  .cards {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .card {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 22px 22px 28px;
  }

  .card p {
    color: var(--soft);
  }

  .big {
    font: 28px/1 var(--font-title);
    color: rgb(255 255 255 / 0.2);
  }
</style>
