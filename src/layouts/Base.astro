---
import '@fontsource/press-start-2p/400.css';
import '@fontsource/silkscreen/400.css';
import '@fontsource/silkscreen/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import Sky from '../components/Sky.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url, type Tint } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Teinte de profil de la page (une seule par page, guide de marque). Violet « Gaming » par défaut. */
  tint?: Tint;
}

const { title, description = site.description, tint = [150, 90, 255] } = Astro.props;
const fullTitle = title ? `${title} · Nexum` : `Nexum · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr" style={`--tint:${tint.join(',')}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url('og.png'), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#000000" />
  </head>
  <body>
    <Sky />
    <div class="app">
      <a class="skip" href="#contenu">Aller au contenu</a>
      <Header />
      <main id="contenu">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .app {
    position: relative;
    z-index: 1;
  }

  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    background: #fff;
    color: #000;
    font: 700 12px/1 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .skip:focus {
    top: 16px;
  }
</style>
