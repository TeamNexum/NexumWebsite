---
import '@fontsource/press-start-2p/400.css';
import '@fontsource/silkscreen/400.css';
import '@fontsource/silkscreen/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import Sky from '../components/Sky.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url, type Tint } from '../data/site';
import { dict, langs, type Lang } from '../i18n';
import type { Alt } from '../i18n/routes';

interface Props {
  lang: Lang;
  /** Adresse de la même page dans chaque langue (sélecteur de langue, hreflang). */
  alt: Alt;
  title?: string;
  description?: string;
  /** Teinte de profil de la page (une seule par page, guide de marque). Violet « Gaming » par défaut. */
  tint?: Tint;
  /** Aperçu de partage (réseaux sociaux), chemin sous public/. Par défaut : l'aperçu de l'accueil dans la langue de la page. */
  image?: string;
}

const { lang, alt, title, description, tint = [150, 90, 255] } = Astro.props;
const image = Astro.props.image ?? `og/home-${lang}.jpeg`;
const t = dict[lang];
const fullTitle = title ? `${title} · Nexum` : `Nexum · ${t.meta.tagline}`;
const desc = description ?? t.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const abs = (path: string) => new URL(path, Astro.site).href;
---

<!doctype html>
<html lang={lang} style={`--tint:${tint.join(',')}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(alt[l])} />)}
    <link rel="alternate" hreflang="x-default" href={abs(alt.en)} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:image" content={abs(url(image))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={abs(url(image))} />
    <meta name="theme-color" content="#000000" />
    <script is:inline>
      // Apparition au défilement : activée seulement avec JavaScript et sans « réduire les animations ».
      // Si le script de page n'a pas démarré au bout de 3 s, tout redevient visible.
      (function () {
        var d = document.documentElement;
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('rv');
        setTimeout(function () {
          if (!d.dataset.rvReady) d.classList.remove('rv');
        }, 3000);
      })();
    </script>
    {
      lang === 'en' && (
        <script is:inline define:vars={{ fr: alt.fr }}>
          // L'anglais est la langue par défaut. Si le visiteur a déjà choisi le français (sélecteur de l'en-tête), on l'y renvoie.
          try {
            if (localStorage.getItem('nexum-lang') === 'fr') location.replace(fr + location.hash);
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body>
    <Sky />
    <div class="app">
      <a class="skip" href="#content">{t.nav.skip}</a>
      <Header lang={lang} alt={alt} />
      <main id="content">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>

<style>
  .app {
    position: relative;
    z-index: 1;
  }

  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    background: #fff;
    color: #000;
    font: 700 12px/1 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .skip:focus {
    top: 16px;
  }
</style>
