---
// Page d'accueil, commune aux deux langues : la langue vient de la page qui l'appelle (src/pages/index.astro, src/pages/fr/index.astro).
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ModeStage from '../components/ModeStage.astro';
import Waitlist from '../components/Waitlist.astro';
import StickyCta from '../components/StickyCta.astro';
import { icons } from '../data/icons';
import { getModes, getSegments, site, team } from '../data/site';
import { dict, fmt, type Lang } from '../i18n';
import { paths } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang];
const tint = getModes(lang)[0]!.tint;
const segments = getSegments(lang);
const stepIcons = [icons.status, icons.spark, icons.launch];
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<Base lang={lang} alt={{ en: paths.home('en'), fr: paths.home('fr') }} tint={tint}>
  <Hero eyebrow={t.hero.eyebrow} tint={tint}>
    <Fragment slot="title">{t.hero.title[0]}<br />{t.hero.title[1]}</Fragment>
    <p class="lead">
      <strong>{t.hero.leadStrong}</strong>{t.hero.lead}
    </p>
    <ul class="mode-lines">
      {t.hero.modeLines.map((l, i) => (
        <li><i>{num(i)}</i><strong>{l.mode}</strong><span class="dash" aria-hidden="true"></span><span>{l.what}</span></li>
      ))}
    </ul>
    <div class="ctas">
      <a class="btn btn-primary" href="#beta">{t.hero.primary}</a>
      <a class="btn" href="#modes">{t.hero.secondary}</a>
    </div>
    <p class="meta">{t.meta.stage}</p>
  </Hero>

  <section class="section" id="problem">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <p class="lab">{t.problem.lab}</p>
        <h2>{t.problem.title}</h2>
        <p>{t.problem.intro}</p>
      </div>
      <div class="cards">
        {t.problem.cards.map((p, i) => (
          <article class="panel card" data-reveal style={`--i:${i}`}>
            <span class="big">{num(i)}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="how-it-works">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <p class="lab">{t.how.lab}</p>
        <h2>{t.how.title}</h2>
        <p>{t.how.intro}</p>
      </div>
      <ol class="flow">
        {t.how.steps.map((s, i) => (
          <li data-reveal style={`--i:${i}`}>
            <span class="pn">{num(i)}</span>
            <span class="ic on"><svg class="i" viewBox="0 0 24 24" aria-hidden="true" set:html={stepIcons[i]} /></span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="modes">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <p class="lab">{t.modesSection.lab}</p>
        <h2>{t.modesSection.title}</h2>
        <p>{t.modesSection.intro}</p>
      </div>
      <div data-reveal><ModeStage lang={lang} /></div>
      <p class="note">{t.modesSection.note}</p>
    </div>
  </section>

  <section class="section" id="integrations">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <p class="lab">{t.integrations.lab}</p>
        <h2>{t.integrations.title}</h2>
        <p>{t.integrations.intro}</p>
      </div>
      <div class="integ">
        <div class="panel box" data-reveal>
          <p class="head"><span class="tag">{t.integrations.availableTag}</span><span>{t.integrations.availableNote}</span></p>
          <ul class="chips">{t.integrations.available.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="panel box" data-reveal style="--i:1">
          <p class="head"><span class="tag plain">{t.integrations.plannedTag}</span><span>{t.integrations.plannedNote}</span></p>
          <ul class="chips planned">{t.integrations.planned.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="comparison">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <p class="lab">{t.comparison.lab}</p>
        <h2>{t.comparison.title}</h2>
      </div>
      <div class="panel table-wrap" data-reveal tabindex="0" role="region" aria-label={t.comparison.title}>
        <table>
          <thead>
            <tr>{t.comparison.headers.map((h) => <th scope="col">{h}</th>)}</tr>
          </thead>
          <tbody>
            {t.comparison.rows.map((c) => (
              <tr class={c.name === site.name ? 'us' : ''}>
                <th scope="row">{c.name}<small>{c.sub}</small></th>
                <td>{c.brands}</td>
                <td>{c.code}</td>
                <td>{c.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="use-cases">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <p class="lab">{t.audience.lab}</p>
        <h2>{t.audience.title}</h2>
      </div>
      <div class="cards">
        {segments.map((s, i) => (
          <a class="panel card seg" href={paths.segment(lang, s.slug)} data-reveal style={`--i:${i}`}>
            <span class="big">{num(i)}</span>
            <p class="lab">{s.label}</p>
            <h3>{s.title}</h3>
            <span class="more">{t.audience.discover}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="roadmap">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <p class="lab">{t.roadmap.lab}</p>
        <h2>{t.roadmap.title}</h2>
        <p>{fmt(t.roadmap.intro, { n: team.length, names: team.join(', ') })}</p>
      </div>
      <ol class="roadmap">
        {t.roadmap.items.map((r, i) => (
          <li class={i === 0 ? 'now' : ''} data-reveal style={`--i:${i}`}>
            <p class="when">{r.when}</p>
            <p>{r.what}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap faq">
      <div class="sec-head" data-reveal>
        <p class="lab">{t.faq.lab}</p>
        <h2>{t.faq.title}</h2>
      </div>
      <div class="qa" data-reveal>
        {t.faq.items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Waitlist lang={lang} />
  <StickyCta lang={lang} />
</Base>

<style>
  /* ---------- hero ---------- */
  .mode-lines {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mode-lines li {
    display: flex;
    align-items: center;
    gap: 14px;
    font: 700 11px/1.4 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mode-lines i {
    font-style: normal;
    font-size: 9px;
    color: var(--dim);
  }

  .mode-lines strong {
    min-width: 76px;
    color: #fff;
  }

  .dash {
    flex: 0 1 56px;
    border-top: 1px dashed var(--line-strong);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 16px;
    padding-top: 6px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 700 11px/1.4 var(--font-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .meta::before {
    content: '';
    width: 7px;
    height: 7px;
    background: rgb(var(--tint));
    box-shadow: 0 0 9px rgb(var(--tint));
    animation: blink 1.4s steps(2) infinite;
  }

  /* ---------- cartes numérotées (problème, pour qui) ---------- */
  .cards {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .card {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 22px 22px 28px;
    text-decoration: none;
  }

  .card p:not(.lab) {
    color: var(--soft);
  }

  .big {
    font: 28px/1 var(--font-title);
    color: #6a6a76;
  }

  .seg {
    min-height: 240px;
    transition: box-shadow var(--step-hover), background var(--step-hover);
  }

  .seg h3 {
    font: 16px/1.6 var(--font-title);
    letter-spacing: 0;
    text-transform: none;
  }

  .seg:hover {
    background: rgb(12 12 16 / 0.92);
    box-shadow: inset 0 0 0 1px #fff;
  }

  .seg:hover .big {
    color: rgb(var(--tint));
  }

  .more {
    margin-top: auto;
    padding-top: 10px;
    font: 700 12px/1 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
  }

  /* ---------- fonctionnement : chaîne en trois étapes ---------- */
  .flow {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow li {
    position: relative;
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 20px 20px 24px;
    background: rgb(255 255 255 / 0.03);
    border: 1px solid #fff;
  }

  .flow li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 40px;
    right: -29px;
    width: 28px;
    border-top: 1px dashed #fff;
  }

  .flow .pn {
    position: absolute;
    top: 14px;
    right: 16px;
    font: 700 10px var(--font-label);
    letter-spacing: 0.1em;
    color: var(--dim);
  }

  .flow .ic {
    margin-bottom: 8px;
    box-shadow: 0 0 18px rgb(255 255 255 / 0.4);
  }

  .flow p {
    color: var(--soft);
  }

  .note {
    margin-top: 18px;
    font-size: 12.5px;
    color: var(--dim);
  }

  /* ---------- intégrations ---------- */
  .integ {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .box {
    padding: 24px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    color: var(--muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 7px 12px;
    border: 1px solid var(--line-strong);
    background: rgb(255 255 255 / 0.03);
    font-size: 13px;
  }

  .chips li::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 9px;
    vertical-align: middle;
    background: #fff;
  }

  .chips.planned li {
    border-style: dashed;
    background: none;
    color: var(--muted);
  }

  .chips.planned li::before {
    background: none;
    border: 1px solid #777;
  }

  /* ---------- comparaison ---------- */
  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 16px 20px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px dashed var(--line-strong);
  }

  thead th {
    font: 700 11px/1.4 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  tbody th {
    font-weight: 500;
  }

  tbody th small {
    display: block;
    font-weight: 400;
    font-size: 12.5px;
    color: var(--dim);
  }

  td {
    color: var(--soft);
  }

  tr:last-child th,
  tr:last-child td {
    border-bottom: 0;
  }

  tr.us {
    background: #fff;
  }

  /* `tbody` en tête : sans lui, la règle générale `tbody th small` (gris) l'emporte sur le noir de la ligne blanche. */
  tbody tr.us th,
  tbody tr.us td,
  tbody tr.us small {
    color: #000;
    font-weight: 700;
  }

  tbody tr.us small {
    font-weight: 400;
  }

  .table-wrap:focus-visible {
    outline-offset: -3px; /* le cadre cranté découperait un contour extérieur */
  }

  /* ---------- feuille de route ---------- */
  .roadmap {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roadmap li {
    position: relative;
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 22px;
    border-top: 1px dashed var(--line-strong);
    color: var(--soft);
  }

  .roadmap li::before {
    content: '';
    position: absolute;
    left: 0;
    top: -4px;
    width: 7px;
    height: 7px;
    background: #666;
  }

  .roadmap li.now {
    border-top: 2px solid #fff;
  }

  .roadmap li.now::before {
    top: -5px;
    background: rgb(var(--tint));
    box-shadow: 0 0 9px rgb(var(--tint));
    animation: blink 1.4s steps(2) infinite;
  }

  .when {
    font: 700 12px/1.4 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
  }

  /* ---------- FAQ ---------- */
  .faq {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .faq .sec-head {
    margin-bottom: 0;
  }

  .qa details {
    border-bottom: 1px dashed var(--line-strong);
  }

  .qa details:first-child {
    border-top: 1px dashed var(--line-strong);
  }

  .qa summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .qa summary::-webkit-details-marker {
    display: none;
  }

  .qa summary::after {
    content: '+';
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--line-strong);
    font-weight: 700;
    color: var(--muted);
  }

  .qa summary:hover::after {
    background: #fff;
    color: #000;
  }

  .qa details[open] summary::after {
    content: '−';
    background: #fff;
    color: #000;
  }

  .qa details p {
    padding-bottom: 22px;
    max-width: 62ch;
    color: var(--soft);
  }

  @media (max-width: 900px) {
    .faq,
    .integ {
      grid-template-columns: 1fr;
    }

    .flow {
      grid-template-columns: 1fr;
    }

    .flow li::after {
      display: none;
    }

    .roadmap {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .roadmap {
      grid-template-columns: 1fr;
    }

    .dash {
      display: none;
    }
  }
</style>
