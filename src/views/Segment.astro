---
// Une page par cible (joueurs, streamers, télétravail), commune aux deux langues. Chaque page envoie son segment
// avec le formulaire : on mesure quelle cible s'inscrit le plus.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ModeStage from '../components/ModeStage.astro';
import Waitlist from '../components/Waitlist.astro';
import StickyCta from '../components/StickyCta.astro';
import { getModes, getSegments, type SegmentSlug } from '../data/site';
import { dict, type Lang } from '../i18n';
import { paths, segmentSlugs } from '../i18n/routes';

interface Props {
  lang: Lang;
  slug: SegmentSlug;
}

const { lang, slug } = Astro.props;
const t = dict[lang];
const s = t.segmentPage;
const segment = getSegments(lang).find((x) => x.slug === slug)!;
// Une seule teinte par page : celle du profil de la cible.
const tint = (getModes(lang).find((m) => m.id === segment.mode) ?? getModes(lang)[0]!).tint;
---

<Base
  lang={lang}
  alt={{ en: paths.segment('en', slug), fr: paths.segment('fr', slug) }}
  title={segment.metaTitle}
  description={segment.lead}
  tint={tint}
  image={`og/${segmentSlugs.en[slug]}-${lang}.jpeg`}
>
  <Hero eyebrow={`Nexum / ${segment.label}`} tint={tint}>
    <Fragment slot="title">{segment.title}</Fragment>
    <p class="lead">{segment.lead}</p>
    <div class="ctas">
      <a class="btn btn-primary" href="#beta">{s.primary}</a>
      <a class="btn" href="#demo">{s.secondary}</a>
    </div>
    <p class="meta">{t.meta.stage}</p>
  </Hero>

  <section class="section">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <p class="lab">{s.whyLab}</p>
        <h2>{s.whyTitle}</h2>
      </div>
      <div class="cards">
        {segment.pains.map((p, i) => (
          <article class="panel card" data-reveal style={`--i:${i}`}>
            <span class="big">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="demo">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <p class="lab">{s.demoLab}</p>
        <h2>{s.demoTitle}</h2>
        <p>{s.demoIntro}</p>
      </div>
      <div data-reveal><ModeStage lang={lang} initial={segment.mode} /></div>
    </div>
  </section>

  <Waitlist lang={lang} segment={segment.slug} title={s.waitlistTitle} />
  <StickyCta lang={lang} />
</Base>

<style>
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 16px;
    padding-top: 6px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 700 11px/1.4 var(--font-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .meta::before {
    content: '';
    width: 7px;
    height: 7px;
    background: rgb(var(--tint));
    box-shadow: 0 0 9px rgb(var(--tint));
    animation: blink 1.4s steps(2) infinite;
  }

  .cards {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  .card {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 22px 22px 28px;
  }

  .card p {
    color: var(--soft);
  }

  .big {
    font: 28px/1 var(--font-title);
    color: #6a6a76;
  }
</style>
