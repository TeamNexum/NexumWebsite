---
import Mark from './Mark.astro';
import { dict, langs, type Lang } from '../i18n';
import { paths, type Alt } from '../i18n/routes';

interface Props {
  lang: Lang;
  alt: Alt;
}

const { lang, alt } = Astro.props;
const t = dict[lang].nav;

// Le numéro est celui de la section sur la page d'accueil.
const links = [
  { n: '02', id: 'how-it-works', label: t.items.how },
  { n: '03', id: 'modes', label: t.items.modes },
  { n: '04', id: 'integrations', label: t.items.integrations },
  { n: '06', id: 'use-cases', label: t.items.audience },
  { n: '08', id: 'faq', label: t.items.faq },
];
---

<header class="top">
  <div class="in">
    <a class="logo" href={paths.home(lang)} aria-label={t.home}><Mark size={22} /><span>NEXUM</span></a>

    <nav class="tabs" aria-label={t.main}>
      {links.map((l) => (
        <a href={paths.section(lang, l.id)} data-spy={l.id}><i>{l.n}</i>{l.label}</a>
      ))}
    </nav>

    <div class="nr">
      <div class="lang" role="group" aria-label={t.language}>
        {
          langs.map((l) =>
            l === lang ? (
              <span lang={l} aria-current="true">{l.toUpperCase()}</span>
            ) : (
              <a href={alt[l]} lang={l} hreflang={l} data-lang={l}>{l.toUpperCase()}</a>
            ),
          )
        }
      </div>
      <a class="btn btn-primary cta" href={paths.section(lang, 'beta')}>{t.cta}</a>
      <details class="menu">
        <summary aria-label={t.menu}><span>{t.menu}</span></summary>
        <nav class="sheet panel" aria-label={t.mobile}>
          {links.map((l) => (
            <a href={paths.section(lang, l.id)}><i>{l.n}</i>{l.label}</a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Section visible = onglet souligné (page d'accueil seulement : les ancres existent là).
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('.tabs a[data-spy]')];
  const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
  if (tabs.length && sections.length) {
    const mark = () => {
      const line = innerHeight * 0.35;
      let current = '';
      for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s.id;
      for (const t of tabs) {
        if (t.dataset.spy === current) t.setAttribute('aria-current', 'true');
        else t.removeAttribute('aria-current');
      }
    };
    addEventListener('scroll', mark, { passive: true });
    mark();
  }

  // Sur une page de cible, le bouton « Rejoindre la bêta » mène au formulaire de cette page (sinon l'inscription
  // serait comptée pour l'accueil et non pour la cible).
  if (document.getElementById('beta')) {
    for (const a of document.querySelectorAll<HTMLAnchorElement>('.top a.cta')) a.setAttribute('href', '#beta');
  }

  // Le choix de langue est gardé dans le navigateur : l'anglais est la langue par défaut, un visiteur qui choisit le français y revient.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.lang a[data-lang]')) {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('nexum-lang', link.dataset.lang!);
      } catch {
        // Stockage indisponible (navigation privée) : le choix vaut pour cette page seulement.
      }
    });
  }

  // Menu mobile : se ferme au choix d'un lien, ou d'un clic ailleurs.
  const menu = document.querySelector<HTMLDetailsElement>('.top details.menu');
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.sheet a')) menu.open = false;
  });
  document.addEventListener('click', (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) menu.open = false;
  });
</script>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(0 0 0 / 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  /* Filet de teinte sous la barre, comme dans l'application. */
  .top::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(var(--tint), 0.95) 50%, transparent);
  }

  .in {
    display: flex;
    align-items: center;
    gap: 28px;
    max-width: 1360px;
    height: 64px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 11px/1 var(--font-title);
    letter-spacing: 0.08em;
    text-decoration: none;
    color: #fff;
  }

  .logo :global(.mark) {
    filter: drop-shadow(0 0 6px rgba(var(--tint), 0.85));
  }

  .tabs {
    display: flex;
    gap: 2px;
    flex: 1;
    margin-left: 6px;
  }

  .tabs a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 64px;
    padding: 0 14px;
    font: 700 12px/1 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s, background 0.2s;
  }

  .tabs i {
    font-style: normal;
    font-size: 9px;
    color: var(--dim);
    transition: color 0.2s;
  }

  .tabs a:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.05);
  }

  .tabs a:hover i {
    color: var(--accent);
  }

  .tabs a[aria-current] {
    color: #fff;
  }

  .tabs a[aria-current] i {
    color: rgb(var(--tint));
  }

  .tabs a[aria-current]::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 0;
    height: 3px;
    background: #fff;
    box-shadow: 0 0 12px rgb(255 255 255 / 0.7);
    clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 100%, 0 100%);
  }

  .nr {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  /* Sélecteur de langue : deux cases carrées, la langue courante en blanc. */
  .lang {
    display: flex;
    border: 1px solid var(--line-strong);
    background: #000;
  }

  .lang a,
  .lang span {
    display: grid;
    place-items: center;
    min-width: 36px;
    height: 38px;
    padding: 0 8px;
    font: 700 11px/1 var(--font-label);
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  .lang a {
    color: var(--muted);
    transition: background var(--step-hover), color var(--step-hover);
  }

  .lang a:hover {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  .lang span {
    background: #fff;
    color: #000;
  }

  .cta {
    min-height: 40px;
    padding: 0 16px;
    box-shadow: 3px 3px 0 rgba(var(--tint), 0.85);
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    height: 40px;
    padding: 0 14px;
    list-style: none;
    border: 1px solid var(--line-strong);
    background: #000;
    font: 700 11px/1 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu[open] summary {
    background: #fff;
    color: #000;
  }

  .sheet {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    display: grid;
    min-width: 230px;
    padding: 10px;
    background: #000;
  }

  .sheet a {
    display: flex;
    gap: 12px;
    padding: 12px 10px;
    font: 700 12px/1 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--soft);
    border-left: 3px solid transparent;
  }

  .sheet a i {
    font-style: normal;
    color: var(--dim);
  }

  .sheet a:hover {
    color: #fff;
    background: linear-gradient(90deg, rgb(255 255 255 / 0.12), transparent 90%);
    border-left-color: #fff;
  }

  @media (max-width: 1000px) {
    .tabs {
      display: none;
    }

    .menu {
      display: block;
    }
  }

  @media (max-width: 460px) {
    .nr {
      gap: 8px;
    }

    .lang a,
    .lang span {
      min-width: 32px;
      padding: 0 6px;
    }

    .cta {
      padding: 0 10px;
      font-size: 10px;
    }

    .logo span {
      display: none;
    }
  }
</style>
