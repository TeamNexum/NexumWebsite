---
// Démo interactive : l'interface de l'application, avec ses quatre profils d'exemple.
// Un profil = une constellation de nœuds (une action par nœud) qui s'allument dans l'ordre d'exécution.
// Les actions affichées sont des exemples : celles que le prototype sait faire ou qui sont prévues.
import { getModes } from '../data/site';
import { icons } from '../data/icons';
import { dict, fmt, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  initial?: string;
}

const { lang, initial } = Astro.props;
const modes = getModes(lang);
const t = dict[lang].stage;
const start = Math.max(0, modes.findIndex((m) => m.id === initial));
const pad = (n: number) => String(n).padStart(2, '0');
// Tout ce que le script affiche (journal, étapes, notifications) vient de ce dictionnaire.
const strings = { ...t, kinds: dict[lang].kinds, decimal: dict[lang].decimal };
---

<div
  class="stg"
  data-stage
  data-start={start}
  data-modes={JSON.stringify(modes)}
  data-icons={JSON.stringify(icons)}
  data-t={JSON.stringify(strings)}
>
  <div class="deck panel">
    <div class="deck-h lab">
      <span>{t.browse}</span>
      <span class="st">
        <button type="button" class="snd" data-sound aria-pressed="false" aria-label={t.soundLabel}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z"></path><path class="w" d="M16 9l4 6M20 9l-4 6"></path><path class="v" d="M16 8c2 2 2 6 0 8M19 5c4 4 4 10 0 14"></path></svg>
          <span data-snd-label>{t.soundOff}</span>
        </button>
        <button type="button" data-prev aria-label={t.prev}>←</button>
        <button type="button" data-next aria-label={t.next}>→</button>
      </span>
    </div>
    <div class="rowc" data-list role="group" aria-label={t.group}>
      <div class="gt">{fmt(t.profiles, { n: pad(modes.length) })}</div>
      {modes.map((m, i) => (
        <button type="button" class="cd" style={`--c:${m.tint.join(',')}`} data-i={i} aria-pressed={i === start ? 'true' : 'false'}>
          <span class="top">
            <span class="ic"><svg class="i" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[m.icon]} /></span>
            <span class="tag act-tag">{t.active}</span>
          </span>
          <span>
            <b>{m.name}</b>
            <small>{fmt(t.actions, { n: m.steps.length })}</small>
            <small class="ds">{m.desc}</small>
          </span>
          <span class="dots">{m.steps.map(() => <i />)}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="stage panel">
    <span class="sr-only" data-sr aria-live="polite"></span>
    <div class="vis" data-vis>
      <div class="fx"><canvas data-nova aria-hidden="true"></canvas></div>
      <svg class="cst" data-cst aria-hidden="true"></svg>
      <div class="cap" data-cap></div>
      <div class="tele" data-tele></div>
      <div class="state" data-state></div>
      <div class="hintv">{t.hint}</div>
    </div>

    <div class="info">
      <div class="i-l">
        <div class="pos"><span class="seg" data-seg></span><span data-pos></span></div>
        <div class="ttl">
          <span class="chipi"><svg class="i" data-bigicon viewBox="0 0 24 24" aria-hidden="true"></svg></span>
          <h3 class="nm" data-name></h3>
        </div>
        <p class="desc" data-desc></p>
        <p class="trig"><span>{t.trigger}</span><b data-trig></b></p>
      </div>
      <div class="i-r">
        <div class="lab" data-syst></div>
        <div class="sys" data-sys></div>
        <div class="dock">
          <button type="button" class="launch" data-go aria-pressed="false">
            <span class="fill"></span>
            <span class="lt">
              <span class="pl"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5l12 7-12 7z"></path></svg></span>
              <span class="tx"><span class="l1" data-go-title>{t.activate}</span><span class="l2" data-go-hint>{t.hold}</span></span>
            </span>
          </button>
        </div>
        <label class="failchk">
          <input type="checkbox" data-fail />
          <span class="bx" aria-hidden="true"></span>
          <span>{t.fail}</span>
        </label>
        <p class="keys" aria-hidden="true">
          <kbd>←</kbd><kbd>→</kbd> {t.keysBrowse} · <kbd>Enter</kbd> {t.keysLaunch}
        </p>
      </div>
    </div>

    <div class="chain">
      <div class="lab"><span>{t.chain}</span><span data-cnt></span></div>
      <ol class="pipe" data-steps></ol>
    </div>

    <div class="journal">
      <div class="lab">{t.journal}</div>
      <div class="term" data-log role="log" aria-live="off"></div>
    </div>
  </div>

  <div class="toast" data-toast role="status"></div>
  <noscript><p class="muted">{t.noscript}</p></noscript>
</div>

<script>
  import { createGalaxy, type Tint } from '../scripts/galaxy';
  import { sfx } from '../scripts/sound';

  type Step = { kind: string; label: string; detail: string; value: string };
  type Mode = { id: string; name: string; icon: string; tint: Tint; desc: string; trigger: string; steps: Step[] };
  type Plate = { x: number; y: number; side: 'r' | 'l' };
  type Strings = Record<string, string> & { kinds: Record<string, string> };

  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pad = (n: number) => (n < 10 ? `0${n}` : `${n}`);
  // Remplace les {clé} d'un texte (les textes viennent du dictionnaire de la page, voir src/i18n).
  const fmt = (text: string, vars: Record<string, string | number>) => text.replace(/\{(\w+)\}/g, (_, k: string) => String(vars[k] ?? `{${k}}`));
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function hash(t: string) {
    let h = 2166136261;
    for (let q = 0; q < t.length; q++) {
      h ^= t.charCodeAt(q);
      h = Math.imul(h, 16777619);
    }
    return h >>> 0;
  }

  function rnd(a: number) {
    return () => {
      a = Math.imul(a ^ (a >>> 15), 1 | a);
      a ^= a + Math.imul(a ^ (a >>> 7), 61 | a);
      return ((a ^ (a >>> 14)) >>> 0) / 4294967296;
    };
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-stage]')) init(root);

  function init(root: HTMLElement) {
    const modes: Mode[] = JSON.parse(root.dataset.modes ?? '[]');
    const icons: Record<string, string> = JSON.parse(root.dataset.icons ?? '{}');
    const T = JSON.parse(root.dataset.t ?? '{}') as Strings;
    const dec = (n: number) => n.toFixed(1).replace('.', T.decimal ?? '.');
    const kindName = (k: string) => T.kinds[k] ?? k;
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const svgIcon = (k: string) => `<svg class="i" viewBox="0 0 24 24" aria-hidden="true">${icons[k] ?? ''}</svg>`;

    const list = $('[data-list]');
    const cards = [...root.querySelectorAll<HTMLButtonElement>('.cd')];
    const stage = $('.stage');
    const vis = $('[data-vis]');
    const cst = $<SVGSVGElement>('[data-cst]');
    const nameEl = $('[data-name]');
    const go = $<HTMLButtonElement>('[data-go]');
    const goTitle = $('[data-go-title]');
    const goHint = $('[data-go-hint]');
    const failChk = $<HTMLInputElement>('[data-fail]');
    const stepsEl = $('[data-steps]');
    const logEl = $('[data-log]');
    const toastEl = $('[data-toast]');

    let sel = Math.min(modes.length - 1, Number(root.dataset.start ?? 0));
    let act = -1;
    let run = 0; // numéro d'activation en cours : invalide les minuteries d'un affichage périmé
    let VW = 800;
    let VH = 480;
    const logs: { t: string; tg: string; c: string; x: string }[] = [];

    const galaxy = createGalaxy($<HTMLCanvasElement>('[data-nova]'), modes[sel]!.tint, RM);

    /* ---------- constellation ---------- */
    function fit() {
      VW = vis.clientWidth || VW;
      VH = vis.clientHeight || VH;
      cst.setAttribute('viewBox', `${-Math.floor(VW / 2)} ${-Math.floor(VH / 2)} ${VW} ${VH}`);
    }

    // Le SVG est à l'échelle 1:1 du cadre : le texte reste net. Les plaques s'alignent en deux colonnes, reliées par un trait ;
    // sur petit écran, il ne reste que les nœuds numérotés et la chaîne d'activation fait office de liste.
    function constel(mode: Mode, lit: boolean, running: boolean) {
      const n = mode.steps.length;
      const R = rnd(hash(mode.name));
      const W = VW;
      const H = VH;
      const small = W < 640;
      const PW = 172;
      const PH = 46;
      const M = 22;
      const RX = small ? Math.max(60, Math.min(W * 0.32, 130)) : Math.max(80, Math.min(150, (W - 2 * PW - 2 * M - 90) / 2));
      const RY = Math.max(70, Math.min(H * 0.29, 128));
      const pts: [number, number][] = [];
      const pls: (Plate | undefined)[] = [];
      const gh: [number, number, number, string][] = [];
      const sides: { r: number[]; l: number[] } = { r: [], l: [] };
      let h = '';

      for (let q = 0; q < n; q++) {
        const a = ((-90 + (360 * q) / n) * Math.PI) / 180;
        pts.push([Math.round(Math.cos(a) * RX), Math.round(Math.sin(a) * RY)]);
      }

      if (!small) {
        for (let q = 0; q < n; q++) {
          const x0 = pts[q]![0];
          const sd = x0 > 8 ? 'r' : x0 < -8 ? 'l' : sides.r.length <= sides.l.length ? 'r' : 'l';
          sides[sd].push(q);
        }
        for (const sd of ['r', 'l'] as const) {
          const ids = sides[sd].slice().sort((a, b) => pts[a]![1] - pts[b]![1]);
          const gap = PH + 12;
          const lim = H / 2 - 54 - PH / 2;
          let ys = ids.map((i) => Math.max(-lim, Math.min(lim, pts[i]![1])));
          for (let t = 1; t < ys.length; t++) ys[t] = Math.max(ys[t]!, ys[t - 1]! + gap);
          const over = ys.length ? ys[ys.length - 1]! - lim : 0;
          if (over > 0) ys = ys.map((y) => y - over);
          ids.forEach((i, t) => {
            const px = sd === 'r' ? W / 2 - M - PW : -W / 2 + M;
            pls[i] = { x: Math.round(px), y: Math.round(ys[t]! - PH / 2), side: sd };
          });
        }
      }

      // Étoiles fantômes : quelques carrés qui scintillent, loin de la galaxie, des plaques et des nœuds.
      for (let k = 0; k < 60 && gh.length < 14; k++) {
        const gx = Math.round((R() - 0.5) * (W - 30));
        const gy = Math.round((R() - 0.5) * (H - 70));
        let ok = Math.hypot(gx, gy * 1.15) > 70;
        for (const o of pls) if (o && gx > o.x - 14 && gx < o.x + PW + 14 && gy > o.y - 14 && gy < o.y + PH + 14) ok = false;
        for (const b of pts) if (Math.hypot(gx - b[0], gy - b[1]) < 26) ok = false;
        if (ok) gh.push([gx, gy, R() < 0.3 ? 3 : 2, (R() * 2.6).toFixed(1)]);
      }

      h += `<line class="ax" x1="${-W / 2}" y1="0" x2="${W / 2}" y2="0"/><line class="ax" x1="0" y1="${-H / 2}" x2="0" y2="${H / 2}"/>`;
      h += `<ellipse class="rg o" cx="0" cy="0" rx="${RX + 64}" ry="${RY + 54}"/><ellipse class="rg" cx="0" cy="0" rx="${RX}" ry="${RY}"/>`;
      for (let q = 0; q < 24; q++) {
        const ta = (q * Math.PI) / 12;
        const tx = Math.cos(ta);
        const ty = Math.sin(ta);
        const ln = q % 6 === 0 ? 10 : 4;
        h += `<line class="tk" x1="${(tx * RX).toFixed(1)}" y1="${(ty * RY).toFixed(1)}" x2="${(tx * (RX + ln)).toFixed(1)}" y2="${(ty * (RY + ln * 0.9)).toFixed(1)}"/>`;
      }
      for (const g of gh.slice(0, 5)) {
        let best = pts[0]!;
        for (const b of pts) if (Math.hypot(g[0] - b[0], g[1] - b[1]) < Math.hypot(g[0] - best[0], g[1] - best[1])) best = b;
        h += `<line class="gl" x1="${g[0]}" y1="${g[1]}" x2="${best[0]}" y2="${best[1]}"/>`;
      }
      for (const g of gh) h += `<rect class="gs" x="${g[0]}" y="${g[1]}" width="${g[2]}" height="${g[2]}" style="--d:${g[3]}s"/>`;

      // Liaisons dans l'ordre d'exécution, du noyau au dernier nœud.
      const segs: string[] = [];
      let prev: [number, number] = [0, 0];
      pts.forEach((b, q) => {
        segs.push(`x1="${prev[0]}" y1="${prev[1]}" x2="${b[0]}" y2="${b[1]}" style="--l:${Math.round(Math.hypot(b[0] - prev[0], b[1] - prev[1]))};--i:${q}"`);
        prev = b;
      });
      for (const st of segs) h += `<line class="cu" ${st}/>`;
      for (const st of segs) h += `<line class="cl${lit ? ' lit' : ''}${running ? ' run' : ''}" ${st}/>${running ? `<line class="cl hd" ${st}/>` : ''}`;

      // Noyau : étoile à quatre branches, carré blanc, pulsation par paliers.
      h += '<g class="core"><rect class="ho" x="-8" y="-8" width="16" height="16"/><rect class="ho b" x="-8" y="-8" width="16" height="16"/><rect x="-2" y="-18" width="4" height="36"/><rect x="-18" y="-2" width="36" height="4"/><rect class="dm" x="-11" y="-11" width="3" height="3"/><rect class="dm" x="8" y="-11" width="3" height="3"/><rect class="dm" x="-11" y="8" width="3" height="3"/><rect class="dm" x="8" y="8" width="3" height="3"/><rect class="cd2" x="-6" y="-6" width="12" height="12"/><rect class="ci" x="-2" y="-2" width="4" height="4"/></g>';

      pts.forEach((b, q) => {
        const [x, y] = b;
        const o = pls[q];
        h += `<g class="ng${lit ? ' lit' : ''}" data-n="${q}">`;
        if (o) {
          const my = o.y + PH / 2;
          const ex = o.side === 'r' ? o.x - 18 : o.x + PW + 18;
          const ed = o.side === 'r' ? o.x : o.x + PW;
          h += `<polyline class="ld" points="${x},${y} ${ex},${my} ${ed},${my}"/><rect class="le" x="${ed - 2}" y="${my - 2}" width="4" height="4"/>`;
        }
        h +=
          `<rect class="hi" style="--n:${q}" x="${x - 8}" y="${y - 8}" width="16" height="16"/><rect class="ho" x="${x - 8}" y="${y - 8}" width="16" height="16"/>` +
          `<rect class="ar" x="${x - 1}" y="${y - 15}" width="2" height="30"/><rect class="ar" x="${x - 15}" y="${y - 1}" width="30" height="2"/>` +
          `<rect class="nf" x="${x - 8}" y="${y - 8}" width="16" height="16"/><rect class="nd" x="${x - 3}" y="${y - 3}" width="6" height="6"/><rect x="${x - 18}" y="${y - 18}" width="36" height="36" fill="transparent"/>`;
        const step = mode.steps[q]!;
        if (o) {
          h +=
            `<g class="pl"><rect class="pb" x="${o.x}" y="${o.y}" width="${PW}" height="${PH}"/><rect class="pn" x="${o.x + 3}" y="${o.y}" width="29" height="${PH}"/><rect class="pa" x="${o.x}" y="${o.y}" width="3" height="${PH}"/>` +
            `<text class="pi" x="${o.x + 17}" y="${o.y + PH / 2 + 4}" text-anchor="middle">${pad(q + 1)}</text>` +
            `<text class="n" x="${o.x + 42}" y="${o.y + 19}">${esc(kindName(step.kind).toUpperCase())}</text><text class="v" x="${o.x + 42}" y="${o.y + 37}">${esc(step.value)}</text></g>`;
        } else {
          h += `<text class="ni" x="${x + 11}" y="${y - 10}">${pad(q + 1)}</text>`;
        }
        h += '</g>';
      });

      cst.innerHTML = `<g class="fade">${h}</g>`;
      $('[data-cap]').textContent = fmt(T.constellation!, { name: mode.name });
      $('[data-tele]').textContent = fmt(T.telemetry!, { n: pad(n) });
    }

    function hl(n: number) {
      cst.querySelectorAll<SVGGElement>('.ng').forEach((g) => g.classList.toggle('hl', Number(g.dataset.n) === n));
      stepsEl.querySelectorAll('li').forEach((l, i) => l.classList.toggle('hl', i - 1 === n));
    }

    /* ---------- affichage d'un profil ---------- */
    let scrambling = 0;
    function scramble(el: HTMLElement, text: string) {
      clearInterval(scrambling);
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789#+*';
      let f = 0;
      const total = 14;
      scrambling = window.setInterval(() => {
        f++;
        let out = '';
        for (let q = 0; q < text.length; q++) out += text[q] === ' ' || q < (text.length * f) / total ? text[q] : chars[(Math.random() * chars.length) | 0];
        el.textContent = out;
        if (f >= total) {
          clearInterval(scrambling);
          el.textContent = text;
        }
      }, 32);
    }

    function swap() {
      for (const query of ['[data-pos]', '[data-desc]', '[data-syst]', '[data-sys]', '[data-bigicon]', '[data-steps]']) {
        const e = $(query);
        e.classList.remove('swap');
        void e.getBoundingClientRect();
        e.classList.add('swap');
      }
    }

    function centerCard() {
      const cd = cards[sel];
      if (!cd) return;
      const scroll = () => {
        if (cd.isConnected) list.scrollTo({ left: cd.offsetLeft - list.clientWidth / 2 + cd.offsetWidth / 2, behavior: RM ? 'auto' : 'smooth' });
      };
      scroll();
      if (!RM) setTimeout(scroll, 300);
    }

    function show(kick = false) {
      const m = modes[sel]!;
      const on = sel === act;
      root.style.setProperty('--tint', m.tint.join(','));
      galaxy.setTint(m.tint);
      nameEl.textContent = m.name;
      $('[data-desc]').textContent = m.desc;
      $('[data-trig]').textContent = m.trigger;
      $('[data-bigicon]').innerHTML = icons[m.icon] ?? '';
      $('[data-pos]').textContent = `${pad(sel + 1)} / ${pad(modes.length)}`;
      $('[data-seg]').innerHTML = modes.map((_, i) => `<i class="${i === sel ? 'on' : ''}"></i>`).join('');
      const kinds = [...new Set(m.steps.map((s) => s.kind))];
      $('[data-syst]').textContent = fmt(kinds.length > 1 ? T.systemMany! : T.systemOne!, { n: pad(kinds.length) });
      $('[data-sys]').innerHTML = kinds.map((k) => `<span>${esc(kindName(k))}</span>`).join('');
      $('[data-cnt]').textContent = fmt(T.count!, { n: pad(m.steps.length), t: dec(m.steps.length * 0.3) });
      stepsEl.innerHTML =
        `<li class="${on ? 'on' : ''}"><span class="pn">00</span><span class="ic${on ? ' on' : ''}">${svgIcon(m.icon)}</span><b>${esc(m.name)}</b><small>${esc(T.start!)}</small><em>T+${dec(0)} s</em></li>` +
        m.steps
          .map(
            (s, i) =>
              `<li class="${on ? 'on' : ''}"><span class="pn">${pad(i + 1)}</span><span class="ic${on ? ' on' : ''}">${svgIcon(s.kind)}</span><b>${esc(kindName(s.kind))}</b><small>${esc(s.detail)}</small><em>T+${dec((i + 1) * 0.3)} s</em></li>`,
          )
          .join('');
      go.setAttribute('aria-pressed', String(on));
      goTitle.textContent = on ? T.isActive! : T.activate!;
      goHint.textContent = on ? T.chainDone! : T.hold!;
      $('[data-state]').textContent = on ? T.stateActive! : T.stateSaved!;
      cards.forEach((c, i) => {
        c.setAttribute('aria-pressed', String(i === sel));
        c.classList.toggle('is-active', i === act);
      });
      centerCard();
      constel(m, on, false);
      $('[data-sr]').textContent = fmt(T.srSteps!, { name: m.name, n: m.steps.length });
      if (kick && !RM) {
        galaxy.kick();
        scramble(nameEl, m.name);
        swap();
      }
    }

    function pick(i: number) {
      sel = (i + modes.length) % modes.length;
      run++;
      show(true);
      sfx.pick();
    }

    /* ---------- son : coupé par défaut, activé par le bouton de l'en-tête ---------- */
    const sndBtn = $<HTMLButtonElement>('[data-sound]');
    const sndLabel = $('[data-snd-label]');
    const renderSound = () => {
      sndBtn.setAttribute('aria-pressed', String(sfx.enabled));
      sndLabel.textContent = sfx.enabled ? T.soundOn! : T.soundOff!;
    };
    sndBtn.addEventListener('click', () => {
      sfx.toggle();
      renderSound();
    });
    renderSound();

    list.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.cd');
      if (b) pick(Number(b.dataset.i));
    });
    list.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      pick(sel + (e.key === 'ArrowRight' ? 1 : -1));
      cards[sel]?.focus();
    });
    $('[data-prev]').addEventListener('click', () => pick(sel - 1));
    $('[data-next]').addEventListener('click', () => pick(sel + 1));

    /* ---------- journal ---------- */
    function logRender() {
      logEl.innerHTML =
        logs.map((l) => `<div class="ln"><time>${l.t}</time><span class="tg ${l.c}">${l.tg}</span><span class="tx">${esc(l.x)}</span></div>`).join('') +
        '<div class="ln"><time></time><span class="cur"></span></div>';
      logEl.scrollTop = logEl.scrollHeight;
    }

    function logAdd(tg: string, c: string, x: string) {
      const d = new Date();
      logs.push({ t: `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`, tg, c, x });
      if (logs.length > 60) logs.shift();
      logRender();
    }

    let toastTimer = 0;
    function toast(t: string) {
      toastEl.textContent = t;
      toastEl.classList.add('on');
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toastEl.classList.remove('on'), 2200);
    }

    /* ---------- activation : une étape toutes les 300 ms ---------- */
    function activate() {
      const m = modes[sel]!;
      if (act === sel) {
        toast(fmt(T.already!, { name: m.name }));
        return;
      }
      act = sel;
      const id = ++run;
      const n = m.steps.length;
      const failAt = failChk.checked ? m.steps.findIndex((s) => s.kind === 'lighting') : -1;
      show(true);

      const lis = [...stepsEl.querySelectorAll('li')];
      const paint = (k: number, silent = false) => {
        const bad = failAt >= 0 && k - 1 === failAt;
        if (k > 0 && !silent) sfx.step(k - 1, bad);
        const li = lis[k];
        li?.classList.add(bad ? 'fail' : 'on');
        li?.querySelector('.ic')?.classList.toggle('on', !bad);
        if (bad && li) li.querySelector('em')!.textContent = T.failed!;
        if (k > 0) cst.querySelectorAll(`[data-n="${k - 1}"]`).forEach((e) => e.classList.add(bad ? 'fail' : 'lit'));
      };

      lis.forEach((l) => {
        l.classList.remove('on');
        l.querySelector('.ic')?.classList.remove('on');
      });
      sfx.start();
      if (RM) lis.forEach((_, k) => paint(k, true));
      else {
        constel(m, false, true);
        lis.forEach((_, k) => setTimeout(() => id === run && paint(k), 300 * k));
      }

      const line = (i: number) => {
        const s = m.steps[i]!;
        if (i === failAt) logAdd(T.tagFail!, 'bad', fmt(T.stepFail!, { kind: kindName(s.kind) }));
        else logAdd(T.tagOk!, 'ok', `${kindName(s.kind)} → ${s.detail}`);
      };
      logAdd(T.tagRun!, 'run', fmt(T.run!, { name: m.name }));
      m.steps.forEach((_, i) => (RM ? line(i) : setTimeout(() => line(i), 300 * (i + 1))));
      const done = () => {
        if (id === run) sfx.done(failAt < 0);
        if (failAt >= 0) {
          logAdd(T.tagSys!, '', fmt(T.doneFail!, { name: m.name, ok: n - 1, n }));
          logAdd(T.tagSys!, '', T.retry!);
        } else logAdd(T.tagOk!, 'ok', fmt(T.doneOk!, { name: m.name, n, t: dec(n * 0.3) }));
      };
      if (RM) done();
      else setTimeout(done, 300 * (n + 1));
      toast(fmt(failAt >= 0 ? T.activatedFail! : T.activated!, { name: m.name }));
    }

    /* ---------- « maintenir pour lancer » : 650 ms, le relâcher annule ---------- */
    const HOLD = 650;
    let holdStart = 0;
    let holdRaf = 0;

    function holdStep(now: number) {
      const q = Math.min(1, (now - holdStart) / HOLD);
      go.style.setProperty('--p', `${(q * 100).toFixed(1)}%`);
      goHint.textContent = fmt(T.launching!, { p: Math.round(q * 100) });
      if (q >= 1) {
        holdRaf = 0;
        go.classList.remove('holding');
        go.style.removeProperty('--p');
        activate();
      } else holdRaf = requestAnimationFrame(holdStep);
    }

    function holdBegin() {
      if (holdRaf) return;
      if (act === sel) {
        toast(fmt(T.already!, { name: modes[sel]!.name }));
        return;
      }
      if (RM) {
        activate();
        return;
      }
      go.classList.add('holding');
      holdStart = performance.now();
      holdRaf = requestAnimationFrame(holdStep);
    }

    function holdEnd() {
      if (!holdRaf) return;
      cancelAnimationFrame(holdRaf);
      holdRaf = 0;
      go.classList.remove('holding');
      go.style.removeProperty('--p');
      goHint.textContent = T.hold!;
      toast(T.holdToast!);
    }

    go.addEventListener('pointerdown', (e) => {
      if (e.button) return;
      holdBegin();
    });
    for (const t of ['pointerup', 'pointerleave', 'pointercancel', 'blur']) go.addEventListener(t, holdEnd);
    go.addEventListener('contextmenu', (e) => e.preventDefault());
    // Au clavier, pas de geste à tenir : Entrée ou Espace active tout de suite.
    go.addEventListener('keydown', (e) => {
      if ((e.key === 'Enter' || e.key === ' ') && !e.repeat) {
        e.preventDefault();
        activate();
      }
    });
    // Les chiffres 1 à 4 choisissent un profil quand le focus est dans la démo (hors champ de saisie).
    root.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey || (e.target as HTMLElement).closest('input, textarea')) return;
      const n = Number(e.key);
      if (Number.isInteger(n) && n >= 1 && n <= modes.length) pick(n - 1);
    });

    /* ---------- liaisons, redimensionnement, parallaxe ---------- */
    cst.addEventListener('mouseover', (e) => {
      const g = (e.target as Element).closest<SVGGElement>('.ng');
      hl(g ? Number(g.dataset.n) : -1);
    });
    cst.addEventListener('mouseleave', () => hl(-1));
    stepsEl.addEventListener('mouseover', (e) => {
      const l = (e.target as Element).closest('li');
      hl(l ? [...stepsEl.children].indexOf(l) - 1 : -1);
    });
    stepsEl.addEventListener('mouseleave', () => hl(-1));

    let resizeTimer = 0;
    const relayout = () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (vis.clientWidth !== VW || vis.clientHeight !== VH) {
          fit();
          constel(modes[sel]!, sel === act, false);
        }
      }, 80);
    };
    new ResizeObserver(relayout).observe(vis);

    if (!RM && matchMedia('(pointer: fine)').matches) {
      stage.addEventListener('mousemove', (e) => {
        const r = stage.getBoundingClientRect();
        stage.style.setProperty('--mx', ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
        stage.style.setProperty('--my', ((e.clientY - r.top) / r.height - 0.5).toFixed(3));
      });
    }

    const total = modes.reduce((a, m) => a + m.steps.length, 0);
    logAdd(T.tagSys!, '', fmt(T.ready!, { p: pad(modes.length), a: total }));
    logAdd(T.tagSys!, '', T.idle!);
    fit();
    show(false);
  }
</script>

