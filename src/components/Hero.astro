---
// Couverture : la galaxie pixel à droite, le titre en bas à gauche (page 1 du guide de marque).
import type { Tint } from '../data/site';

interface Props {
  eyebrow: string;
  tint: Tint;
}

const { eyebrow, tint } = Astro.props;
---

<section class="hero">
  <div class="gx" aria-hidden="true">
    <canvas data-hero-galaxy data-tint={tint.join(',')}></canvas>
  </div>
  <div class="wrap">
    <div class="copy">
      <p class="lab">{eyebrow}</p>
      <h1><slot name="title" /></h1>
      <slot />
    </div>
  </div>
</section>

<script>
  import { createGalaxy, type Tint } from '../scripts/galaxy';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-hero-galaxy]')) {
    createGalaxy(canvas, (canvas.dataset.tint ?? '150,90,255').split(',').map(Number) as Tint, reduce);
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(86vh, 800px);
    padding-block: clamp(56px, 9vw, 112px) clamp(56px, 8vw, 96px);
    overflow: clip;
  }

  /* Halo : lueur douce de la teinte derrière la galaxie. */
  .gx {
    position: absolute;
    top: 50%;
    right: -4%;
    z-index: 0;
    width: min(56vw, 780px);
    aspect-ratio: 1;
    transform: translateY(-50%);
  }

  .gx::before {
    content: '';
    position: absolute;
    inset: -14%;
    background: radial-gradient(circle at 50% 50%, rgba(var(--tint), 0.24), transparent 42%);
  }

  canvas {
    position: relative;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    filter: drop-shadow(0 0 18px rgba(var(--tint), 0.4));
  }

  .wrap {
    position: relative;
    z-index: 1;
  }

  .copy {
    position: relative;
    display: grid;
    gap: 26px;
    max-width: 620px;
  }

  /* Voile noir sous le texte : le ciel reste visible, mais la lecture passe avant. */
  .copy::before {
    content: '';
    position: absolute;
    inset: -70px -90px -50px -130px;
    z-index: -1;
    background: radial-gradient(ellipse at 42% 50%, rgb(0 0 0 / 0.78), transparent 70%);
    pointer-events: none;
  }

  .copy :global(h1) {
    font-size: clamp(22px, 2.9vw, 34px);
  }

  @media (max-width: 900px) {
    .hero {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding-top: 24px;
    }

    .gx {
      position: relative;
      top: auto;
      right: auto;
      order: -1;
      width: min(92%, 440px);
      margin: 0 auto -28px;
      transform: none;
    }
  }
</style>
