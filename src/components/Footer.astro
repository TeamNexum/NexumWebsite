---
import Mark from './Mark.astro';
import { getSegments, site, team } from '../data/site';
import { dict, fmt, joinNames, type Lang } from '../i18n';
import { paths } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang];
const segments = getSegments(lang);
---

<footer class="foot">
  <div class="wrap grid">
    <div class="about">
      <a class="brand" href={paths.home(lang)} aria-label={t.nav.home}><Mark size={28} /><span>NEXUM</span></a>
      <p>{t.meta.tagline}</p>
      <p class="small">{fmt(t.footer.credit, { names: joinNames(lang, team) })}</p>
    </div>

    <nav aria-label={t.footer.audience}>
      <p class="lab">{t.footer.audience}</p>
      {segments.map((s) => <a href={paths.segment(lang, s.slug)}>{s.label}</a>)}
    </nav>

    <nav aria-label={t.footer.nexum}>
      <p class="lab">{t.footer.nexum}</p>
      <a href={paths.section(lang, 'beta')}>{t.footer.join}</a>
      <a href={site.github} rel="noopener">{t.footer.github}</a>
      <a href={paths.privacy(lang)}>{t.footer.privacy}</a>
    </nav>
  </div>

  <div class="wrap base">
    <span>{t.footer.base}</span>
    <span>© {new Date().getFullYear()} Nexum</span>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    padding-top: 56px;
    border-top: 1px dashed var(--line-strong);
    background: linear-gradient(to bottom, transparent, rgb(0 0 0 / 0.6));
  }

  .grid {
    display: grid;
    gap: 40px;
    grid-template-columns: 2fr 1fr 1fr;
  }

  .about {
    display: grid;
    gap: 14px;
    align-content: start;
    max-width: 380px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    font: 13px/1 var(--font-title);
    letter-spacing: 0.08em;
    text-decoration: none;
    color: #fff;
  }

  .about p {
    color: var(--soft);
  }

  .small {
    font-size: 13px;
    color: var(--muted);
  }

  nav {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  nav .lab {
    margin-bottom: 4px;
  }

  nav a {
    width: fit-content;
    color: var(--text);
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 48px;
    padding-bottom: 22px;
    font: 700 11px/1.4 var(--font-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* Filet en tirets aligné sur le contenu (la bordure du conteneur déborderait sur les marges). */
  .base::before {
    content: '';
    flex-basis: 100%;
    margin-bottom: 10px;
    border-top: 1px dashed var(--line-strong);
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .about {
      grid-column: 1 / -1;
    }
  }
</style>
