---
import { segments, site, team, url } from '../data/site';
---

<footer class="band footer">
  <div class="wrap grid">
    <div class="about">
      <a class="brand" href={url()}>
        <img src={url('favicon.svg')} alt="Logo Nexum" width="36" height="36" />
        <span>Nexum</span>
      </a>
      <p>{site.tagline}</p>
      <p class="small">
        Projet EIP Epitech, conçu par {team.slice(0, -1).join(', ')} et {team.at(-1)}.
      </p>
    </div>

    <nav aria-label="Pour qui">
      <p class="title">Pour qui</p>
      {segments.map((s) => <a href={url(`pour/${s.slug}`)}>{s.label}</a>)}
    </nav>

    <nav aria-label="Liens">
      <p class="title">Nexum</p>
      <a href={url('#beta')}>Rejoindre la bêta</a>
      <a href={site.github} rel="noopener">GitHub</a>
      <a href={url('confidentialite')}>Confidentialité</a>
    </nav>
  </div>
  <div class="wrap base">
    <span>L’équipe Nexum · Projet EIP Epitech</span>
    <span>© {new Date().getFullYear()} Nexum</span>
  </div>
</footer>

<style>
  .footer {
    padding-top: 64px;
  }

  .grid {
    display: grid;
    gap: 40px;
    grid-template-columns: 2fr 1fr 1fr;
  }

  .about {
    display: grid;
    gap: 14px;
    align-content: start;
    max-width: 360px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .brand img {
    border-radius: 9px;
  }

  p {
    color: var(--on-band-2);
  }

  .small {
    font-size: 14px;
  }

  nav {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .title {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  nav a {
    color: var(--on-band);
    text-decoration: none;
    font-size: 15px;
  }

  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 56px;
    padding-block: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-band-2);
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .about {
      grid-column: 1 / -1;
    }
  }
</style>
