---
// Fond de page : le ciel de l'application, fixe derrière tout le contenu.
// Il est le plus vif en haut (la couverture) et s'apaise en descendant, là où l'on lit.
---

<div class="sky" id="sky" aria-hidden="true">
  <canvas id="sky-main"></canvas>
  <canvas id="sky-twinkle"></canvas>
</div>

<script>
  import { initSky } from '../scripts/sky';

  const wrap = document.getElementById('sky');
  const main = document.getElementById('sky-main') as HTMLCanvasElement | null;
  const twinkle = document.getElementById('sky-twinkle') as HTMLCanvasElement | null;
  if (wrap && main && twinkle) {
    initSky(wrap, main, twinkle, matchMedia('(prefers-reduced-motion: reduce)').matches);

    // Opacité : 0,85 en haut de page, 0,4 après environ 70 % de la hauteur d'écran.
    let frame = 0;
    const dim = () => {
      frame = 0;
      const t = Math.min(1, scrollY / (innerHeight * 0.7));
      wrap.style.opacity = (0.85 - 0.45 * t).toFixed(3);
    };
    addEventListener(
      'scroll',
      () => {
        if (!frame) frame = requestAnimationFrame(dim);
      },
      { passive: true },
    );
    dim();
  }
</script>

<style>
  .sky {
    position: fixed;
    inset: -30px;
    z-index: 0;
    pointer-events: none;
    opacity: 0.85;
    transition: transform 0.8s ease-out;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    image-rendering: pixelated;
  }
</style>
