---
// Inscription à la bêta + recrutement pour les entretiens utilisateurs (validation marché).
// Chaque envoi porte le segment de la page et les paramètres UTM : on compare ainsi
// quelles cibles répondent le plus (stratégie « du pêcheur » conseillée par le mentor).
import { url } from '../data/site';

interface Props {
  segment?: string;
  title?: string;
}

const { segment = 'accueil', title = 'Un clic. Tout votre setup.' } = Astro.props;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const profiles = [
  { value: 'joueurs', label: 'Je joue sur PC' },
  { value: 'streamers', label: 'Je streame ou crée du contenu' },
  { value: 'teletravail', label: 'Je travaille sur mon ordinateur' },
  { value: 'autre', label: 'Autre' },
];
---

<section class="section beta" id="beta">
  <div class="wrap inner">
    <div class="intro">
      <p class="lab">Bientôt en bêta</p>
      <h2>{title}</h2>
      <p class="lead">
        <strong>Inscrivez-vous pour tester Nexum avant tout le monde.</strong> Vous recevrez un e-mail à l’ouverture de la bêta, rien d’autre. Si vous avez 20 minutes, dites-nous ce qui vous agace sur votre ordinateur : cela décidera des prochains modes.
      </p>
    </div>

    <form class="form panel" data-waitlist data-endpoint={endpoint} novalidate>
      <input type="hidden" name="segment" value={segment} />
      <div class="field">
        <label for={`email-${segment}`}>E-mail</label>
        <input id={`email-${segment}`} name="email" type="email" autocomplete="email" required placeholder="vous@exemple.fr" />
      </div>

      <fieldset class="field">
        <legend>Vous êtes plutôt</legend>
        <div class="options">
          {profiles.map((p) => (
            <label class="option">
              <input type="radio" name="profil" value={p.value} checked={p.value === segment} />
              <span>{p.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="field">
        <label for={`pain-${segment}`}>Ce qui vous agace le plus sur votre ordinateur <span class="opt">(facultatif)</span></label>
        <textarea id={`pain-${segment}`} name="agacement" rows="3" maxlength="1000" placeholder="Ex. : je rouvre les mêmes 6 applis chaque matin…"></textarea>
      </div>

      <label class="check">
        <input type="checkbox" name="entretien" value="oui" />
        <span class="bx" aria-hidden="true"></span>
        <span>OK pour un entretien de 20 minutes avec l’équipe (visio ou message).</span>
      </label>

      <label class="check">
        <input type="checkbox" name="consentement" value="oui" required />
        <span class="bx" aria-hidden="true"></span>
        <span>J’accepte que Nexum garde mon e-mail et mes réponses pour me recontacter au sujet de la bêta. <a href={url('confidentialite')}>En savoir plus</a></span>
      </label>

      <button class="btn btn-primary" type="submit" disabled={!endpoint}>
        {endpoint ? 'Rejoindre la bêta' : 'Inscriptions bientôt ouvertes'}
      </button>
      <p class="status" role="status" aria-live="polite" data-status></p>
    </form>
  </div>
</section>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-waitlist]')) {
    const endpoint = form.dataset.endpoint;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!endpoint) return;

      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        status.textContent = 'Vérifiez votre adresse e-mail.';
        form.querySelector<HTMLInputElement>('input[name=email]')?.focus();
        return;
      }
      if (!data.get('consentement')) {
        status.textContent = 'Cochez la case de consentement pour que nous puissions vous recontacter.';
        return;
      }

      const params = new URLSearchParams(location.search);
      for (const key of ['utm_source', 'utm_medium', 'utm_campaign']) {
        const value = params.get(key);
        if (value) data.set(key, value);
      }
      data.set('page', location.pathname);

      button.disabled = true;
      status.textContent = 'Envoi…';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = 'Inscription enregistrée. Un e-mail vous préviendra à l’ouverture de la bêta.';
      } catch {
        status.textContent = 'L’envoi a échoué. Réessayez dans un instant.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .inner {
    display: grid;
    gap: clamp(40px, 6vw, 80px);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
  }

  .intro {
    display: grid;
    gap: 24px;
  }

  .form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    padding: clamp(22px, 3vw, 32px);
  }

  .field {
    display: grid;
    gap: 8px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  label,
  legend {
    padding: 0;
    font: 700 11px/1.5 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .opt {
    color: var(--dim);
    font-weight: 400;
  }

  input[type='email'],
  textarea {
    width: 100%;
    padding: 13px 14px;
    background: #000;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    color: var(--text);
    font: 500 15px/1.4 var(--font-body);
    resize: vertical;
  }

  input[type='email']:focus,
  textarea:focus {
    outline: 2px dashed var(--accent);
    outline-offset: 3px;
    border-color: #fff;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--dim);
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .option {
    position: relative;
    text-transform: none;
    letter-spacing: 0;
  }

  .option input {
    position: absolute;
    opacity: 0;
  }

  .option span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    background: #000;
    font: 500 13px/1.3 var(--font-body);
    color: var(--soft);
    cursor: pointer;
    transition: background var(--step-hover), color var(--step-hover);
  }

  .option span:hover {
    border-color: #fff;
  }

  .option input:checked + span {
    background: #fff;
    border-color: #fff;
    color: #000;
  }

  .option input:focus-visible + span {
    outline: 2px dashed var(--accent);
    outline-offset: 3px;
  }

  .check {
    position: relative;
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 12px;
    font: 400 13px/1.55 var(--font-body);
    letter-spacing: 0;
    text-transform: none;
    color: var(--soft);
    cursor: pointer;
  }

  .check input {
    position: absolute;
    opacity: 0;
  }

  .bx {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    border: 1px solid var(--line-strong);
    background: #000;
    font-size: 12px;
    line-height: 1;
    color: #000;
  }

  .check input:checked + .bx {
    background: #fff;
  }

  .check input:checked + .bx::after {
    content: '✓';
  }

  .check input:focus-visible + .bx {
    outline: 2px dashed var(--accent);
    outline-offset: 3px;
  }

  .btn {
    justify-self: start;
    max-width: 100%;
    padding-block: 12px;
    white-space: normal;
    text-align: center;
    line-height: 1.4;
  }

  .status {
    min-height: 1.6em;
    font-size: 13px;
    color: var(--soft);
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
