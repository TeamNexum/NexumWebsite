---
// Inscription à la bêta + recrutement pour les entretiens utilisateurs (validation marché).
// Chaque envoi porte le segment de la page et les paramètres UTM : on compare ainsi
// quelles cibles répondent le plus (stratégie « du pêcheur » conseillée par le mentor).
import { dict, type Lang } from '../i18n';
import { paths } from '../i18n/routes';

interface Props {
  lang: Lang;
  /** Valeur envoyée avec le formulaire (la page d'origine) : elle ne change pas avec la langue, pour comparer les cibles. */
  segment?: string;
  title?: string;
}

const { lang, segment = 'accueil', title } = Astro.props;
const t = dict[lang].waitlist;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
// Les valeurs restent celles d'origine (joueurs, streamers…) ; seuls les libellés changent.
const profiles = (['joueurs', 'streamers', 'teletravail', 'autre'] as const).map((value) => ({ value, label: t.profiles[value] }));
const messages = {
  checkEmail: t.checkEmail,
  checkConsent: t.checkConsent,
  sending: t.sending,
  success: t.success,
  error: t.error,
  offline: t.offline,
  submit: t.submit,
};
---

<section class="section beta" id="beta">
  <div class="wrap inner">
    <div class="intro" data-reveal>
      <p class="lab">{t.lab}</p>
      <h2>{title ?? t.title}</h2>
      <p class="lead">
        <strong>{t.leadStrong}</strong>{t.lead}
      </p>
    </div>

    <form class="form panel" data-reveal style="--i:1" data-waitlist data-endpoint={endpoint} data-messages={JSON.stringify(messages)} novalidate>
      <div class="fields" data-fields>
        <input type="hidden" name="segment" value={segment} />
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="_subject" value="Nexum · beta sign-up" />

        <!-- Piège à robots : un humain ne voit pas ce champ. Rempli, l'envoi est ignoré (convention Formspree : _gotcha). -->
        <div class="hp" aria-hidden="true">
          <label>{t.honeypot}<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="field">
          <label for={`email-${segment}`}>{t.email}</label>
          <input
            id={`email-${segment}`}
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            maxlength="254"
            required
            placeholder={t.emailPlaceholder}
            aria-describedby={`email-err-${segment}`}
          />
          <p class="err" id={`email-err-${segment}`} data-err="email" hidden>{t.checkEmail}</p>
        </div>

        <fieldset class="field">
          <legend>{t.legend}</legend>
          <div class="options">
            {profiles.map((p) => (
              <label class="option">
                <input type="radio" name="profil" value={p.value} checked={p.value === segment} />
                <span>{p.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="field">
          <label for={`pain-${segment}`}>{t.pain} <span class="opt">{t.optional}</span></label>
          <textarea id={`pain-${segment}`} name="agacement" rows="3" maxlength="1000" placeholder={t.painPlaceholder}></textarea>
        </div>

        <label class="check">
          <input type="checkbox" name="entretien" value="oui" />
          <span class="bx" aria-hidden="true"></span>
          <span>{t.interview}</span>
        </label>

        <div class="field">
          <label class="check">
            <input type="checkbox" name="consentement" value="oui" required aria-describedby={`consent-err-${segment}`} />
            <span class="bx" aria-hidden="true"></span>
            <span>{t.consent} <a href={paths.privacy(lang)}>{t.learnMore}</a></span>
          </label>
          <p class="err" id={`consent-err-${segment}`} data-err="consent" hidden>{t.checkConsent}</p>
        </div>

        <button class="btn btn-primary" type="submit" disabled={!endpoint}>
          {endpoint ? t.submit : t.soon}
        </button>
        <p class="status" role="status" aria-live="polite" data-status></p>
      </div>

      <!-- Affiché à la place du formulaire une fois l'envoi confirmé par le serveur : on ne peut pas s'inscrire deux fois par erreur. -->
      <div class="done" data-done hidden role="status" tabindex="-1">
        <span class="tag">OK</span>
        <h3>{t.successTitle}</h3>
        <p>{t.success}</p>
      </div>
    </form>
  </div>
</section>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const TIMEOUT = 15000; // un serveur qui ne répond pas ne doit pas laisser le bouton bloqué sur « Envoi… »

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-waitlist]')) {
    const endpoint = form.dataset.endpoint;
    const msg: Record<string, string> = JSON.parse(form.dataset.messages ?? '{}');
    const fields = form.querySelector<HTMLElement>('[data-fields]')!;
    const done = form.querySelector<HTMLElement>('[data-done]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const email = form.querySelector<HTMLInputElement>('input[name=email]')!;
    const consent = form.querySelector<HTMLInputElement>('input[name=consentement]')!;
    let sending = false;

    const say = (text: string, kind: 'err' | '' = '') => {
      status.textContent = text;
      status.dataset.kind = kind;
    };
    // Un champ invalide est signalé par du texte, une bordure en tirets et aria-invalid : jamais par la couleur seule.
    const flag = (input: HTMLInputElement, key: string, bad: boolean) => {
      input.setAttribute('aria-invalid', String(bad));
      form.querySelector<HTMLElement>(`[data-err="${key}"]`)!.hidden = !bad;
    };

    // L'erreur disparaît dès que le champ est corrigé.
    email.addEventListener('input', () => {
      if (email.getAttribute('aria-invalid') === 'true' && EMAIL.test(email.value.trim())) flag(email, 'email', false);
    });
    consent.addEventListener('change', () => {
      if (consent.checked) flag(consent, 'consent', false);
    });

    function finish() {
      form.reset();
      fields.hidden = true;
      done.hidden = false;
      done.focus();
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!endpoint || sending) return;
      say('');

      const data = new FormData(form);
      // Champ piège rempli : c'est un robot. On fait comme si tout allait bien, sans rien envoyer.
      if (String(data.get('_gotcha') ?? '') !== '') {
        finish();
        return;
      }

      const mail = email.value.trim();
      const emailOk = EMAIL.test(mail);
      flag(email, 'email', !emailOk);
      flag(consent, 'consent', !consent.checked);
      if (!emailOk) return email.focus();
      if (!consent.checked) return consent.focus();

      if (!navigator.onLine) return say(msg.offline ?? '', 'err');

      data.set('email', mail);
      const params = new URLSearchParams(location.search);
      for (const key of ['utm_source', 'utm_medium', 'utm_campaign']) {
        const value = params.get(key);
        if (value) data.set(key, value);
      }
      data.set('page', location.pathname);

      sending = true;
      button.disabled = true;
      button.textContent = msg.sending ?? '';
      const abort = new AbortController();
      const timer = setTimeout(() => abort.abort(), TIMEOUT);
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
          signal: abort.signal,
        });
        // 422 : le service refuse l'e-mail (Formspree). On le montre sur le champ plutôt qu'un message générique.
        if (res.status === 422) {
          flag(email, 'email', true);
          email.focus();
          return;
        }
        if (!res.ok) throw new Error(String(res.status));
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean };
        if (body.ok === false) throw new Error('refused');
        finish();
      } catch {
        say(msg.error ?? '', 'err');
      } finally {
        clearTimeout(timer);
        sending = false;
        button.disabled = false;
        button.textContent = msg.submit ?? '';
      }
    });
  }
</script>

<style>
  .inner {
    display: grid;
    gap: clamp(40px, 6vw, 80px);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
  }

  .intro {
    display: grid;
    gap: 24px;
  }

  .form {
    padding: clamp(22px, 3vw, 32px);
  }

  .fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
  }

  /* `display: grid` l'emporte sur l'attribut hidden : on le rétablit pour ces éléments. */
  .fields[hidden],
  .done[hidden],
  .err[hidden] {
    display: none;
  }

  /* Piège à robots : hors écran (pas display:none, que certains robots savent éviter), invisible pour les humains. */
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Message d'erreur d'un champ : carré « × » devant le texte, la bordure du champ passe en tirets blancs. */
  .err {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    font-size: 12.5px;
    color: #fff;
  }

  .err::before {
    content: '×';
    flex: none;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border: 1px solid #fff;
    font: 700 11px/1 var(--font-label);
  }

  .field input[aria-invalid='true'] {
    border: 1px dashed #fff;
  }

  .field .check input[aria-invalid='true'] + .bx {
    border: 1px dashed #fff;
  }

  .done {
    display: grid;
    gap: 14px;
    justify-items: start;
    padding-block: 8px;
    outline: none;
  }

  .done h3 {
    font: clamp(13px, 1.5vw, 16px) / 1.6 var(--font-title);
    letter-spacing: 0;
    text-transform: none;
  }

  .done p {
    color: var(--soft);
  }

  .field {
    display: grid;
    gap: 8px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  label,
  legend {
    padding: 0;
    font: 700 11px/1.5 var(--font-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .opt {
    color: var(--dim);
    font-weight: 400;
  }

  input[type='email'],
  textarea {
    width: 100%;
    padding: 13px 14px;
    background: #000;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    color: var(--text);
    font: 500 15px/1.4 var(--font-body);
    resize: vertical;
  }

  input[type='email']:focus,
  textarea:focus {
    outline: 2px dashed var(--accent);
    outline-offset: 3px;
    border-color: #fff;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--dim);
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .option {
    position: relative;
    text-transform: none;
    letter-spacing: 0;
  }

  .option input {
    position: absolute;
    opacity: 0;
  }

  .option span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    background: #000;
    font: 500 13px/1.3 var(--font-body);
    color: var(--soft);
    cursor: pointer;
    transition: background var(--step-hover), color var(--step-hover);
  }

  .option span:hover {
    border-color: #fff;
  }

  .option input:checked + span {
    background: #fff;
    border-color: #fff;
    color: #000;
  }

  .option input:focus-visible + span {
    outline: 2px dashed var(--accent);
    outline-offset: 3px;
  }

  .check {
    position: relative;
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 12px;
    font: 400 13px/1.55 var(--font-body);
    letter-spacing: 0;
    text-transform: none;
    color: var(--soft);
    cursor: pointer;
  }

  .check input {
    position: absolute;
    opacity: 0;
  }

  .bx {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    border: 1px solid var(--line-strong);
    background: #000;
    font-size: 12px;
    line-height: 1;
    color: #000;
  }

  .check input:checked + .bx {
    background: #fff;
  }

  .check input:checked + .bx::after {
    content: '✓';
  }

  .check input:focus-visible + .bx {
    outline: 2px dashed var(--accent);
    outline-offset: 3px;
  }

  .btn {
    justify-self: start;
    max-width: 100%;
    padding-block: 12px;
    white-space: normal;
    text-align: center;
    line-height: 1.4;
  }

  .status {
    min-height: 1.6em;
    font-size: 13px;
    color: var(--soft);
  }

  .status[data-kind='err'] {
    display: flex;
    gap: 8px;
    align-items: baseline;
    color: #fff;
  }

  .status[data-kind='err']::before {
    content: '×';
    flex: none;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border: 1px solid #fff;
    font: 700 11px/1 var(--font-label);
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
